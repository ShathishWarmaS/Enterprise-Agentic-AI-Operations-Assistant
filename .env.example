# Copy to .env and adjust. Every value below has a working default for local/mock mode.

# --- LLM mode ---------------------------------------------------------------
# mock  -> no network calls, deterministic rule-based agents (default)
# claude -> use the Anthropic API (requires ANTHROPIC_API_KEY)
LLM_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=1024

# --- Storage --------------------------------------------------------------
# SQLAlchemy URL. SQLite by default; Docker Compose overrides with Postgres.
DATABASE_URL=sqlite:///./storage/app.sqlite3
# Directory for the FAISS index + chunk metadata.
VECTOR_STORE_DIR=./storage/vector
# Where uploaded source files are kept.
UPLOAD_DIR=./storage/uploads

# --- Redis (optional) ------------------------------------------------------
# Leave blank to use the in-process fallback for session/task state.
REDIS_URL=

# --- Ingestion ---------------------------------------------------------
# OCR PDF pages that have no embedded text (scanned documents).
# Requires: pip install -e ".[ocr]"  AND the tesseract binary on PATH.
PDF_OCR_FALLBACK=false

# --- Retrieval backends -------------------------------------------------
# Embedding backend: hash -> offline deterministic hashed n-grams (default,
# used by CI + the eval harness); sentence_transformers -> neural encoder
# (needs `pip install -e ".[embeddings]"`; not run in CI). Switching this
# invalidates a persisted local index: rm -rf storage/vector and re-seed.
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Vector store: local -> in-process FAISS/numpy index, single worker (default);
# pgvector -> shared Postgres store for multi-worker deploys (needs a Postgres
# DATABASE_URL and `pip install -e ".[pgvector]"`).
VECTOR_BACKEND=local

# --- Retrieval tuning ----------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
# Cosine similarity below this is treated as "no confident match".
RETRIEVAL_MIN_SCORE=0.22

# --- API -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
